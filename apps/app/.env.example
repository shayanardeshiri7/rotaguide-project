# Optional cloud backup (Supabase).
#
# Leave these unset and the sync feature disappears from the UI entirely —
# a build without them is a supported configuration, not a broken one.
# The app is fully functional local-only.
#
# Apply supabase/migrations/0001_injections.sql to the project before
# enabling this; the table is useless (and unprotected) without its RLS
# policies.
#
# The anon key is a public, publishable key. It is safe in the client
# *because* row-level security is what actually protects the data.
# Never put a service-role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

{
  "name": "rotaguide",
  "version": "2.0.0",
  "private": true,
  "description": "Guided insulin injection-site rotation system — 3D-printed placement plate + local-first tracker PWA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shayanardeshiri7/rotaguide-project.git"
  },
  "keywords": [
    "react",
    "typescript",
    "healthcare",
    "pwa",
    "biomedical-engineering",
    "diabetes",
    "capstone"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "e2e": "turbo run e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yml}\""
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
